{
  "name": "elixir_dss",
  "version": "0.4.0-dev",
  "description": "Elixir Luxembourg - Data Submission System (DSS)",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:bootstrap": "sass --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions ../css/bootstrap-custom.scss ../public/css/bootstrap-custom.css",
    "build:select2": "sass --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions ../css/select2-custom.scss ../public/css/select2-custom.css",
    "copy:fonts": "mkdir -p ../public/css/fonts && cp node_modules/bootstrap-icons/font/fonts/* ../public/css/fonts/",
    "build:css": "npm run build:bootstrap && npm run build:select2 && npm run copy:fonts",
    "watch:bootstrap": "sass --watch --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions ../css/bootstrap-custom.scss ../public/css/bootstrap-custom.css",
    "watch:select2": "sass --watch --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions ../css/select2-custom.scss ../public/css/select2-custom.css",
    "watch:css": "npm run watch:bootstrap & npm run watch:select2"
  },
  "repository": {
    "type": "git",
    "url": "https://git-r3lab.uni.lu/elixir/elixir-dcp"
  },
  "author": "Valentin Grouès",
  "license": "ISC",
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "datatables.net": "^2.3.8",
    "datatables.net-bs5": "^2.3.8",
    "handlebars": "^4.7.9",
    "jquery": "^3.7.1",
    "jquery-ui-dist": "^1.13.3",
    "select2": "^4.1.0-rc.0",
    "select2-bootstrap-5-theme": "^1.3.0",
    "tinymce": "^8.8.0",
    "typeahead.js": "^0.11.1",
    "x-editable": "^1.5.1"
  },
  "devDependencies": {
    "sass": "^1.101.0"
  }
}

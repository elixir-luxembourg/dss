FLASK_APP=elixir_dss

# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Options: dev, prod, test
# - dev: Development environment (uses DevConfig)
# - prod: Production environment (uses ProdConfig)
# - test: Testing environment (uses TestConfig)
ELIXIR_DSS_ENV=dev

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_TITLE=Submission System
# IMPORTANT: Generate a secure random key for production
# Example: python -c "import os; print(os.urandom(24))"
SECRET_KEY=your-secret-key-here

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://elixirdcp:elixirdcp@localhost:5432/elixirdcp
#
# SQLite (for development/testing):
DATABASE_URL=sqlite:///dev-elixir-dss.db

# ==============================================================================
# AUTHENTICATION CONFIGURATION
# ==============================================================================
# Authentication Method: CONFIG (local) or AAI (OIDC/Keycloak)
AUTHENTICATION_METHOD=CONFIG

# ==============================================================================
# OIDC/KEYCLOAK SETTINGS (Required when AUTHENTICATION_METHOD=AAI)
# ==============================================================================
# Keycloak realm URL (without trailing slash)
OIDC_AUTHORITY=https://sso.example.com/realms/your-realm
# OAuth2 client credentials
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
# Space-separated OIDC scopes
OIDC_SCOPE=openid email profile
# Set to True in production with HTTPS
OIDC_COOKIE_SECURE=False

# ==============================================================================
# FLASK SESSION CONFIGURATION
# ==============================================================================
SESSION_COOKIE_NAME=dss_session
# HttpOnly prevents JavaScript access to cookies (security)
SESSION_COOKIE_HTTPONLY=True
# SameSite prevents CSRF attacks (Lax, Strict, or None)
SESSION_COOKIE_SAMESITE=Lax
# Secure cookies only sent over HTTPS (set to True in production)
SESSION_COOKIE_SECURE=False
# Session lifetime in seconds (3600 = 1 hour)
PERMANENT_SESSION_LIFETIME=3600

# ==============================================================================
# DATA STEWARDS CONFIGURATION
# ==============================================================================
# Comma-separated list of data steward email addresses
DATA_STEWARDS_MAILS=lcsb-datastewards@uni.lu

# ==============================================================================
# DAISY INTEGRATION
# ==============================================================================
# Enable/disable DAISY integration
DAISY_USE=False
# DAISY service URL
DAISY_URL=https://daisy.lcsb.uni.lu/

# ==============================================================================
# EMAIL/SMTP CONFIGURATION
# ==============================================================================
# Development (Gmail example):
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USE_SSL=True
# MAIL_USE_TLS=False
#
# Production (local SMTP):
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_SSL=False
MAIL_USE_TLS=False
# Mail credentials (optional for localhost)
MAIL_USERNAME=
MAIL_PASSWORD=
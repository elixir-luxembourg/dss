FLASK_APP=elixir_dss

# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Options: dev, prod, test
# - dev: Development environment (uses DevConfig)
# - prod: Production environment (uses ProdConfig)
# - test: Testing environment (uses TestConfig)
ELIXIR_DSS_ENV=dev

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_TITLE=LCSB Data Submission System
# IMPORTANT: Generate a secure random key for production
# Example: python -c "import os; print(os.urandom(24))"
SECRET_KEY=your-secret-key-here

# ==============================================================================
# DATABASE CONFIGURATION (SQLite)
# ==============================================================================
DATABASE_URL=sqlite:///dev-elixir-dss.db

# ==============================================================================
# AUTHENTICATION CONFIGURATION: CONFIG (local) or AAI (OIDC/Keycloak)
# ==============================================================================
AUTHENTICATION_METHOD=CONFIG
OIDC_AUTHORITY=https://sso.example.com/realms/your-realm
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
OIDC_SCOPE=openid email profile
OIDC_COOKIE_SECURE=False

# ==============================================================================
# FLASK SESSION CONFIGURATION
# ==============================================================================
SESSION_COOKIE_NAME=dss_session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
PERMANENT_SESSION_LIFETIME=3600

# ==============================================================================
# DATA STEWARDS CONFIGURATION (Comma-separated list of data steward emails)
# ==============================================================================
DATA_STEWARDS_MAILS=lcsb-datastewards@uni.lu

# ==============================================================================
# DAISY INTEGRATION
# ==============================================================================
DAISY_USE=False
DAISY_URL=https://daisy.lcsb.uni.lu/
DAISY_API_KEY=daisy-api-key
DAISY_VERIFY_SSL=True

# ==============================================================================
# EMAIL/SMTP CONFIGURATION
# ==============================================================================
# local SMTP:
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_SSL=False
MAIL_USE_TLS=False
# Mail credentials (optional for localhost)
MAIL_USERNAME=
MAIL_PASSWORD=

# ==============================================================================
# LFT
# ==============================================================================
LFT_HOST=lft.lcsb.uni.lu
LFT_PORT=8443
LFT_SCHEME=https
LFT_USERNAME=
LFT_PASSWORD=
LFT_NAMESPACE_ID=
LFT_VERIFY_SSL=True
LFT_LINKS_BASE_URL=https://lft.lcsb.uni.lu
LFT_LINK_VALIDITY_DAYS=7

# ==============================================================================
# IDSERVICE INTEGRATION
# ==============================================================================
IDSERVICE_ENDPOINT=
